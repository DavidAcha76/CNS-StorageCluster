<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CNS Storage Cluster</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<header class="topbar">
    <div class="brand">
        <span class="brand-mark">CNS</span>
        <div><strong>Monitor nacional de almacenamiento</strong><small>Storage Cluster · Nodo Central</small></div>
    </div>
    <nav><a asp-page="/Index">Dashboard</a></nav>
</header>
<main class="container">@RenderBody()</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
